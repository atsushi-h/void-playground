{
  "name": "void-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "void prepare && tsc --noEmit",
    "check": "vp check && bun run typecheck",
    "check:fix": "vp check --fix && bun run typecheck",
    "test": "bun test src",
    "test:integration": "bun test tests/integration",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "verify": "bun run check && bun run test && bun run build"
  },
  "dependencies": {
    "@void/react": "^1.1.11",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "void": "^1.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
